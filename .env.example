# Copy to .env for local development only. Do not commit .env.
BOT_TOKEN=
ADMIN_IDS=
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/campuspass
REDIS_URL=redis://localhost:6379/0
ENCRYPTION_KEY=
API_ADMIN_TOKEN=
METRICS_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ENVIRONMENT=development
RUNTIME_MODE=combined
TELEGRAM_DELIVERY_MODE=polling
TELEGRAM_UPDATE_CONSUMERS=4
TELEGRAM_UPDATE_CLAIM_BATCH_SIZE=4
TELEGRAM_UPDATE_IDLE_WAIT_MS=100
TELEGRAM_UPDATE_GRACEFUL_SHUTDOWN_SECONDS=25
CACHE_GENERATION_POLL_SECONDS=2
UPDATE_MIN_COMPATIBLE_VERSION=11.6.0-render-e2e-hardening
UPDATE_MIN_COMPATIBLE_SCHEMA=11.6.0-render-e2e-hardening
UPDATE_CALLBACK_SCHEMA_VERSION=1
UPDATE_EVENT_SCHEMA_VERSION=1
UPDATE_ROLLOUT_PERCENT=100
UPDATE_REQUIRE_EXPAND_CONTRACT=true

# Optional integrations are requested by default and become operational when configured.
FEATURE_GEMINI=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
FEATURE_MASTERCARD=true
PAYMENT_GATEWAY_CREATE_URL=
PAYMENT_GATEWAY_STATUS_URL=
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_WEBHOOK_SECRET=
FEATURE_PROVIDER_WITHDRAWALS=true
MONEY_FLOW_MODEL=gateway_marketplace
BACKUP_ENABLED=true
BACKUP_STORAGE_BACKEND=s3
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
IMAGE_MODERATION_ENABLED=true
IMAGE_MODERATION_PROVIDER=auto
GOOGLE_VISION_API_KEY=
IMAGE_MODERATION_FAIL_CLOSED=false
EVIDENCE_EXTERNAL_STORAGE_ENABLED=true
EVIDENCE_S3_ENDPOINT=
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_REGION=auto
EVIDENCE_S3_ACCESS_KEY=
EVIDENCE_S3_SECRET_KEY=
