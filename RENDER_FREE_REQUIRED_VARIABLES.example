# CampusPass IQ - Render Free essential variables
# Fill these in Render > Environment. Never upload real secrets.

# REQUIRED
BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE
ADMIN_IDS=123456789
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME?ssl=require
PUBLIC_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
ENVIRONMENT=production
RUNTIME_MODE=combined
REQUIRE_EXTERNAL_DATABASE=true
TIMEZONE=Asia/Baghdad

# SECURITY - generate unique long random values
ENCRYPTION_KEY=GENERATE_A_RANDOM_32_BYTE_KEY
REPORT_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
API_ADMIN_TOKEN=GENERATE_A_LONG_RANDOM_SECRET
TELEGRAM_WEBHOOK_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# TELEGRAM / FREE RENDER
TELEGRAM_DELIVERY_MODE=webhook
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
REPORT_CONCURRENCY_LIMIT=1
AI_CONCURRENCY_LIMIT=1
LONG_OPERATION_CONCURRENCY_LIMIT=2
BOT_UPDATE_CONCURRENCY=8
TELEGRAM_HTTP_CONNECTION_LIMIT=16
UVICORN_LIMIT_CONCURRENCY=50

# UI BUTTON COLORS
FEATURE_COLORED_BUTTONS=true
FEATURE_CENTRAL_BUTTON_STYLES=true
BUTTON_STYLE_OVERRIDES_JSON={"exact":{},"prefixes":{}}

# REPORTS
FEATURE_REPORTS=true
REPORT_TOKEN_DAYS=2
REPORT_MAX_ACCESSES=20
DAILY_REPORT_HOUR=23
DAILY_REPORT_MINUTE=55

# GEMINI - leave disabled until key is added
FEATURE_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_DAILY_USER_LIMIT=20

# OPTIONAL REDIS
REDIS_URL=
REQUIRE_REDIS_IN_PRODUCTION=false

# OPTIONAL ERROR MONITORING
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
